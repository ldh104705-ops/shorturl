{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shorturl",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",

  // 웹 화면 정적 파일(index.html, wasm, js, css).
  // 파일이 있는 경로는 Cloudflare가 직접 응답하고, 없는 경로만 Worker(src/index.js)로 간다.
  // public/ 은 `npm run build:web`으로 만든다(git에는 올리지 않음).
  "assets": {
    "directory": "./public",
    "not_found_handling": "none",
    "html_handling": "auto-trailing-slash"
  },

  // Railway 백엔드 주소. 비밀 값이 아니라 공개 주소라 설정 파일에 둔다.
  "vars": {
    "BACKEND_URL": "https://shorturl-production-d0d840c3.up.railway.app"
  },

  "observability": {
    "enabled": true
  }
}
