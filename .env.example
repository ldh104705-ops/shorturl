# 이 파일을 .env로 복사해서 쓰세요. (.env는 git에 올라가지 않습니다)

# PostgreSQL 접속 주소 (docker-compose.yml의 로컬 DB 기준)
DATABASE_URL=postgres://shorturl:shorturl@localhost:5432/shorturl

# 화면에 보여줄 단축 주소의 앞부분 (끝에 / 없이)
PUBLIC_BASE_URL=http://localhost:8080

# Cloudflare Worker와 공유하는 비밀 값 (필수). 비어 있으면 서버가 시작되지 않습니다.
# cloudflare/.dev.vars의 WORKER_SECRET과 같은 값을 넣으세요. 예: openssl rand -hex 32
WORKER_SECRET=

# 단축 대상으로 쓸 수 없는 자기 서비스 주소 (선택, 쉼표로 구분)
# PUBLIC_BASE_URL과 Railway가 주는 RAILWAY_PUBLIC_DOMAIN은 자동으로 포함됩니다.
SELF_HOSTS=
